# ─────────────────────────────────────────────────────────────
# Minecraft AFK Bot — Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# Server address (IP or hostname)
MC_HOST=localhost

# Server port (default: 25565)
MC_PORT=25565

# Bot's Minecraft username
# For offline-mode servers this can be any name.
# For online-mode servers this must be a valid Microsoft account username.
MC_USERNAME=AFKBot

# Minecraft version to connect with (e.g. 1.20.4, 1.19.2).
# Leave blank or remove the line to auto-detect.
MC_VERSION=

# Authentication mode:
#   offline  — for cracked / offline-mode servers (default)
#   microsoft — for online-mode servers (requires Microsoft account)
MC_AUTH=offline

# How many milliseconds to wait before reconnecting after a disconnect (default: 5000)
RECONNECT_DELAY=5000

# Set to "false" to disable automatic reconnection
AUTO_RECONNECT=true

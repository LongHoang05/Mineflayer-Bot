# ─────────────────────────────────────────────────────────────
# Minecraft Combat Bot — Cấu hình
# Sao chép file này thành .env và điền thông tin của bạn.
# ─────────────────────────────────────────────────────────────

# Địa chỉ server (IP hoặc hostname)
MC_HOST=localhost

# Cổng server (mặc định: 25565)
MC_PORT=25565

# Tên người chơi của bot
MC_USERNAME=CombatBot

# Phiên bản Minecraft (vd: 1.20.4, 1.19.2). Để trống để tự nhận.
MC_VERSION=

# Chế độ xác thực:
#   offline   — server không cần tài khoản (mặc định)
#   microsoft — server online-mode (cần tài khoản Microsoft)
MC_AUTH=offline

# Thời gian chờ trước khi kết nối lại (ms)
RECONNECT_DELAY=5000

# Đặt thành "false" để tắt tự động kết nối lại
AUTO_RECONNECT=true

# Khoảng cách tối đa để tấn công (blocks)
ATTACK_RANGE=4

# Bán kính tuần tra xung quanh điểm spawn (blocks)
PATROL_RADIUS=20

# Tốc độ đánh — thời gian giữa mỗi cú đấm (ms). Giảm = đánh nhanh hơn.
ATTACK_SPEED=500
